APP_NAME="نوبت سلامت"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://nobatesalamat.ir
APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR

LOG_CHANNEL=stack
LOG_LEVEL=error

# ---------- MySQL ----------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nobatesalamat
DB_USERNAME=nobat
DB_PASSWORD=NobatSalamat2026

SESSION_DRIVER=database
SESSION_LIFETIME=43200
CACHE_STORE=database
QUEUE_CONNECTION=database

# ---------- ورود موبایلی (Kavenegar) ----------
# اگر کلید خالی باشد، در محیط local کد آزمایشی در پاسخ JSON برگردانده می‌شود
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=login

# ---------- مدیر ارشد پیش‌فرض (در سید ایجاد می‌شود) ----------
ADMIN_PHONE=09120000000

# ---------- به‌روزرسانی وب ----------
# فقط با true شدن، دکمهٔ «به‌روزرسانی پروژه» در پنل فعال می‌شود
ALLOW_WEB_UPDATES=false
# فرمان نهایی اختیاری (مثلاً: php artisan queue:restart یا سوپروایزر ریلود)
UPDATE_FINAL_COMMAND=
