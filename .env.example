APP_NAME="نوبت سلامت"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://nobatesalamat.ir
APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR

LOG_CHANNEL=stack
LOG_LEVEL=error

# ---------- MySQL ----------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nobatesalamat
DB_USERNAME=nobat
DB_PASSWORD=NobatSalamat2026

SESSION_DRIVER=database
SESSION_LIFETIME=43200
CACHE_STORE=database
QUEUE_CONNECTION=database

# ---------- پیامک: پنل ستارگان (srscrm.ir) ----------
# توکن API از پنل پیامک → بخش وب‌سرویس/API
SMS_TOKEN=
# شمارهٔ خط فرستنده (gateway) — همان شماره‌ای که در پنل به آن دسترسی دارید، نه شناسهٔ خط
SMS_GATEWAY=
SMS_BASE_URL=https://srscrm.ir/api/sms/send
# قالب متن پیامک کد ورود؛ %s جای کد قرار می‌گیرد
SMS_OTP_TEMPLATE="کد ورود شما به نوبت سلامت: %s"
SMS_TIMEOUT=15
# اگر SMS_TOKEN خالی باشد: در APP_ENV=local کد در لاگ/پاسخ نمایش داده می‌شود، در production خطا برمی‌گردد

# ---------- کد ورود یک‌بارمصرف (OTP) ----------
# طول عمر کد به ثانیه (پیش‌فرض ۱۸۰ = ۳ دقیقه)
OTP_TTL_SECONDS=180
# فاصلهٔ مجاز بین دو ارسال (ثانیه)
OTP_RESEND_SECONDS=55
# حداکثر تلاش اشتباه برای هر کد
OTP_MAX_ATTEMPTS=5

# ---------- مدیر ارشد پیش‌فرض (در سید ایجاد می‌شود) ----------
ADMIN_PHONE=09120000000

# ---------- به‌روزرسانی سایت از روی Git (EnvKit) ----------
# با true شدن، دکمهٔ «به‌روزرسانی پروژه»، وب‌هوک /deploy و دستور site:update فعال می‌شوند
ALLOW_WEB_UPDATES=false

# توکن مشترک با EnvKit (خالی = وب‌هوک غیرفعال)
# EnvKit این آدرس را صدا می‌زند: POST https://nobatesalamat.ir/deploy/DEPLOY_WEBHOOK_TOKEN
DEPLOY_WEBHOOK_TOKEN=

# شاخه و ریموتی که باید از آن به‌روزرسانی شود
UPDATE_GIT_REMOTE=origin
UPDATE_GIT_BRANCH=main

# فرمان دلخواه Git (خالی = «git pull --ff-only origin main»)
# مثال برای ریست کامل سرور روی نسخهٔ مخزن:
# UPDATE_GIT_COMMAND="git fetch --prune origin && git reset --hard origin/main && git clean -fd"
UPDATE_GIT_COMMAND=

# فقط این IP ها اجازهٔ صدا زدن وب‌هوک را دارند (خالی = بدون محدودیت)
UPDATE_ALLOWED_IPS=

# مسیر اجرایی‌ها و زمان مجاز هر فرمان (ثانیه)
UPDATE_PHP_BINARY=
UPDATE_COMPOSER_BINARY=composer
UPDATE_TIMEOUT=900

# فرمان نهایی اختیاری (مثلاً: php artisan queue:restart یا سوپروایزر ریلود)
UPDATE_FINAL_COMMAND=
